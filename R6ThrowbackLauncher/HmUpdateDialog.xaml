<Window x:Class="R6ThrowbackLauncher.HmUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heated Metal update"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Fg}">

    <Border Margin="14" Background="{DynamicResource Brush.Surface}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <TextBlock Text="Heated Metal update" Style="{StaticResource Text.H2}"/>
            <TextBlock x:Name="SubtitleText" Text="A new version of the Heated Metal mod is available."
                       Style="{StaticResource Text.Body}" Margin="0,6,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Border Style="{StaticResource Chip}">
                    <TextBlock x:Name="CurrentVersionText" Text="Current: v1.0.0" FontSize="12"
                               FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.Fg2}"/>
                </Border>
                <TextBlock Text="&#xE72A;" Style="{StaticResource Text.Icon}" FontSize="12" Margin="10,0"
                           Foreground="{DynamicResource Brush.Fg3}"/>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.Accent}">
                    <TextBlock x:Name="NewVersionText" Text="New: v1.1.0" FontSize="12" FontWeight="SemiBold"
                               FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.OnAccent}"/>
                </Border>
            </StackPanel>

            <Border Margin="0,16,0,0" CornerRadius="8" Padding="14,12" Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="160">
                    <TextBlock x:Name="NotesText" Text="No release notes provided." Style="{StaticResource Text.Body}" FontSize="12"/>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="SkipBtn" Content="Skip this version" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Click="Skip_Click"/>
                <Button x:Name="LaterBtn" Content="Later" Style="{StaticResource Btn.Secondary}" MinWidth="88" Margin="0,0,8,0"
                        IsCancel="True" Click="Later_Click"/>
                <Button x:Name="UpdateNowBtn" Content="Update now" Style="{StaticResource Btn.Primary}" MinWidth="110"
                        IsDefault="True" Click="UpdateNow_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
