<Window x:Class="R6ThrowbackLauncher.GameConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game settings"
        Height="640" Width="820" MinHeight="420" MinWidth="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Fg}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Margin="14" Background="{DynamicResource Brush.Surface}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="22,18,12,14">
                <StackPanel>
                    <TextBlock x:Name="TitleLabel" Text="Game settings" Style="{StaticResource Text.H2}"/>
                    <TextBlock x:Name="FilePathLabel" Text="" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                               FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.Fg3}"/>
                    <TextBlock x:Name="FileStatusLabel" Text="" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource Brush.Fg3}"/>
                </StackPanel>
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        ToolTip="Close" Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1" Margin="22,0,22,0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Stroke}" Background="{DynamicResource Brush.Window}">
                <TextBox x:Name="ConfigTextBox"
                         Background="Transparent" Foreground="{DynamicResource Brush.Fg}"
                         SelectionBrush="{DynamicResource Brush.Fg3}"
                         FontFamily="{DynamicResource Font.Mono}" FontSize="13"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="12,10"
                         CaretBrush="{DynamicResource Brush.Fg}"
                         SpellCheck.IsEnabled="False"/>
            </Border>

            <Grid Grid.Row="2" Margin="22,14,22,18">
                <TextBlock x:Name="SaveStatusLabel" Text="" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Fg2}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Open in Notepad" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Click="OpenInNotepad_Click"/>
                    <Button Content="Cancel" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" MinWidth="88" Click="Cancel_Click"/>
                    <Button Content="Save" Style="{StaticResource Btn.Primary}" MinWidth="88" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
