<Window x:Class="R6ThrowbackLauncher.DetectedInstallsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Existing installs found"
        Height="520" Width="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource Brush.Fg}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Margin="14" Background="{DynamicResource Brush.Surface}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Existing installs found" Style="{StaticResource Text.H2}"/>
                <TextBlock Text="These game folders were found on your PC. Pick the ones to add to your library. Files stay where they are."
                           Style="{StaticResource Text.Body}" Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Select all" Style="{StaticResource Btn.Ghost}" Height="30" Click="SelectAll_Click"/>
                    <Button Content="Select none" Style="{StaticResource Btn.Ghost}" Height="30" Margin="4,0,0,0" Click="DeselectAll_Click"/>
                </StackPanel>
                <TextBlock x:Name="CountLabel" Text="" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource Text.Caption}"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FolderListPanel"/>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Skip" Style="{StaticResource Btn.Secondary}" MinWidth="88" Margin="0,0,8,0" IsCancel="True" Click="Skip_Click"/>
                <Button x:Name="ImportButton" Content="Import selected (0)" Style="{StaticResource Btn.Primary}" IsDefault="True" Click="Import_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
