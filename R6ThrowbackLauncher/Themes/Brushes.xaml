<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Dark palette defaults. ThemeManager replaces these brushes at runtime. -->
    <SolidColorBrush x:Key="Brush.Window"        Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Brush.Sidebar"       Color="#0F0F0F"/>
    <SolidColorBrush x:Key="Brush.Surface"       Color="#141414"/>
    <SolidColorBrush x:Key="Brush.Surface2"      Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Brush.Surface3"      Color="#242424"/>
    <SolidColorBrush x:Key="Brush.Stroke"        Color="#262626"/>
    <SolidColorBrush x:Key="Brush.StrokeStrong"  Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.Fg"            Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Brush.Fg2"           Color="#A3A3A3"/>
    <SolidColorBrush x:Key="Brush.Fg3"           Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Brush.FgDisabled"    Color="#474747"/>
    <SolidColorBrush x:Key="Brush.Accent"        Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Brush.OnAccent"      Color="#0A0A0A"/>
    <SolidColorBrush x:Key="Brush.Hover"         Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Pressed"       Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Selected"      Color="#1F1F1F"/>
    <SolidColorBrush x:Key="Brush.Scrim"         Color="#B8000000"/>
    <SolidColorBrush x:Key="Brush.Stripe"        Color="#26000000"/>
    <SolidColorBrush x:Key="Brush.Track"         Color="#1F1F1F"/>
    <!-- Replaced at startup by ThemeManager with an animated stripe brush. -->
    <SolidColorBrush x:Key="Brush.ProgressStripes" Color="Transparent"/>

    <!-- Artwork scrims stay dark in both themes so overlaid text remains legible. -->
    <LinearGradientBrush x:Key="Brush.ArtFadeBottom" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0.25"/>
        <GradientStop Color="#E6000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ArtFadeLeft" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F0000000" Offset="0"/>
        <GradientStop Color="#99000000" Offset="0.45"/>
        <GradientStop Color="#10000000" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="Size.Body">13</sys:Double>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
</ResourceDictionary>
