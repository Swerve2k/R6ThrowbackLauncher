<Window x:Class="R6ThrowbackLauncher.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="380" Height="240"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.Ui}">

    <Border Margin="12" CornerRadius="14" Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Swerve2k" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Brush.Fg}"/>
                <TextBlock Text="Downloader" FontSize="15" Margin="0,-2,0,0" Foreground="{DynamicResource Brush.Fg2}"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Starting" FontSize="12" Foreground="{DynamicResource Brush.Fg2}"/>
                    <Border Height="3" CornerRadius="1.5" Margin="0,10,0,0" Width="220" HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.Track}" ClipToBounds="True">
                        <Border x:Name="Sweep" Width="70" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Fg}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SweepShift" X="-70"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SweepShift" Storyboard.TargetProperty="X"
                                                             From="-70" To="220" Duration="0:0:1.1">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="VersionText" Grid.Column="1" Text="" FontSize="11" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource Brush.Fg3}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
